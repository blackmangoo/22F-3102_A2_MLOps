# VisionGuard MLOps Configuration Template
# Copy this file to .env and fill in your values (do not commit .env to git)

# API Configuration
API_KEY=visionguard_secret_key
API_URL=http://localhost:10000
PORT=5000

# Database Configuration (Docker Compose uses PostgreSQL; local development defaults to SQLite)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=visionguard
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/visionguard
DB_PATH=history.db

# Experiment Tracking (DagsHub / MLflow)
MLFLOW_TRACKING_URI=https://dagshub.com/blackmangoo/22F-3102_A2_MLOps.mlflow
DAGSHUB_USER_NAME=blackmangoo
DAGSHUB_TOKEN=your_dagshub_token_here
